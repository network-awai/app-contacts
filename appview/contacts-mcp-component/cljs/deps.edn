;; contacts appview frontend — reagent + re-frame, rendered with jp-go-dds
;; (デジタル庁デザインシステム). Migrated from
;; appview/contacts-mcp-component/svelte (SvelteKit: one +page.svelte static
;; app-metadata card + one +server.ts XRPC proxy, the latter preserved at
;; ../src/xrpc-proxy.ts).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias, not
;; top-level :deps (workspace convention; the jvm-new-surface guard rejects new
;; top-level JVM deps). jp-go-dds is a workspace git dep and stays top-level.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                               thheller/shadow-cljs {:mvn/version "2.28.20"}
                               reagent/reagent {:mvn/version "1.2.0"}
                               re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
